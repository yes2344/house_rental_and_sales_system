# Copy to backend/.env and fill in values for an approved, least-privilege
# application role. Read-only credentials are suitable only for inspection.
NODE_ENV=development
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSCHEMA=public
PGSSL=false
# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set PGSSL=true when the PostgreSQL endpoint requires TLS.
# Set PGSSL_REJECT_UNAUTHORIZED=false only when explicitly required and approved.
# Public and private persistent media volumes. The private directory must never
# be mounted as a public/static directory. Production requires both paths.
# MEDIA_ROOT=C:\InfinityHouse\data\media
# PRIVATE_MEDIA_ROOT=C:\InfinityHouse\data\private-media
# Optional provider-confirmed storage allocation for warning calculations.
# This is the app's assigned quota, not a guess based on server disk size.
# MEDIA_CAPACITY_BYTES=
MEDIA_WARNING_PERCENT=80
