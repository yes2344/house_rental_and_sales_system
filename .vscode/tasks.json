{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Django API (local development)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "manage.py",
        "runserver",
        "127.0.0.1:8000",
        "--noreload"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DJANGO_DEBUG": "True",
          "DJANGO_SECURE_SSL_REDIRECT": "False"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "django-runserver",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Performing system checks\\.\\.\\.$",
          "endsPattern": "^Starting (?:WSGI )?development server at http://127\\.0\\.0\\.1:8000/"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
