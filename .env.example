# Copy this file to .env for local configuration. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
# For production behind a trusted HTTPS-terminating proxy, set these only after its forwarded headers are sanitized.
# DJANGO_TRUST_PROXY_SSL_HEADER=True
# Set HSTS only after HTTPS is confirmed for the production hostname.
# DJANGO_SECURE_HSTS_SECONDS=31536000

# SQLite remains the default unless DATABASE_URL or USE_POSTGRES is configured.
# Production uses PostgreSQL-backed throttling cache; run `manage.py createcachetable` after migrations.
# Example PostgreSQL URL (replace every placeholder before use):
# DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
USE_POSTGRES=False
POSTGRES_DB=house_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
