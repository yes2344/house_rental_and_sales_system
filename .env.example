# Copy this file to .env for local configuration. Never commit .env.
# This example enables local development behavior; production must explicitly set DJANGO_DEBUG=False.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
DEFAULT_FROM_EMAIL=Habasha Property Center <no-reply@example.com>
# Local development prints verification and password-reset links to the runserver console.
# Production should configure the provider credentials below and use HTTPS.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT_SECONDS=10
# EMAIL_VERIFICATION_TIMEOUT_SECONDS=86400
# PASSWORD_RESET_TIMEOUT_SECONDS=86400
# For production behind a trusted HTTPS-terminating proxy, set these only after its forwarded headers are sanitized.
# DJANGO_TRUST_PROXY_SSL_HEADER=True
# Set HSTS only after HTTPS is confirmed for the production hostname.
# DJANGO_SECURE_HSTS_SECONDS=31536000

# PostgreSQL is required in every environment. Use either DATABASE_URL or the
# individual POSTGRES_* settings below; SQLite DATABASE_URL values are rejected.
# Production uses PostgreSQL-backed throttling cache; run `manage.py createcachetable` after migrations.
# Example PostgreSQL URL (replace every placeholder before use):
# DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
POSTGRES_DB=house_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional persistent image storage; set this for hosted deployments.
# CLOUDINARY_URL=cloudinary://CLOUD_NAME:API_KEY@CLOUD_NAME
# Optional dedicated test database name. Use a disposable database for tests.
# POSTGRES_TEST_DB=test_homes_local
