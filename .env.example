# Copy this file to .env for local configuration. Never commit .env.
# Production must explicitly set DJANGO_DEBUG=False.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
DEFAULT_FROM_EMAIL=Infinity House <no-reply@example.com>
# Local development prints verification and password-reset links to the runserver console.
# Production should configure provider credentials below and use HTTPS.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT_SECONDS=10
# EMAIL_VERIFICATION_TIMEOUT_SECONDS=86400
# PASSWORD_RESET_TIMEOUT_SECONDS=86400
# For production behind a trusted HTTPS-terminating proxy, set this only after its forwarded headers are sanitized.
# DJANGO_TRUST_PROXY_SSL_HEADER=True
# Set HSTS only after HTTPS is confirmed for the production hostname.
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Development and production both require explicit MySQL connection settings.
MYSQL_DATABASE=house_db
MYSQL_USER=house_user
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Optional CA certificate path when the database provider requires verified TLS.
# MYSQL_SSL_CA=/path/to/mysql-ca.pem
# Optional persistent image storage; set this for hosted deployments.
# CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
# Optional dedicated, disposable test database name.
# MYSQL_TEST_DATABASE=test_house_db
