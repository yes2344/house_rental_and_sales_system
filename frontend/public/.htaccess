Options -Indexes -MultiViews
RewriteEngine On

RewriteCond %{HTTP_HOST} ^(?:www\.)?infinityhouseproperties\.com(?::\d+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.infinityhouseproperties\.com(?::\d+)?$ [NC]
RewriteRule ^ https://infinityhouseproperties.com%{REQUEST_URI} [R=301,L]

# Serve private metadata before the SPA fallback, including for dynamic IDs.
RewriteRule ^(?:submissions/.+|management/listings/.+)$ private-route-fallback.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]
